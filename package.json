{
  "name": "bili-pluma",
  "private": true,
  "version": "0.0.0",
  "description": "B站双账号画质助手",
  "license": "GPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "https://github.com/OWNER/bili-pluma.git"
  },
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "zip": "wxt zip",
    "compile": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:boundaries": "tsx scripts/check-boundaries.ts",
    "verify": "tsc --noEmit && prettier --check . && eslint . && tsx scripts/check-boundaries.ts && vitest run",
    "test": "vitest run",
    "test:watch": "vitest",
    "postinstall": "wxt prepare"
  },
  "dependencies": {
    "preact": "^10.29.8",
    "qrcode-generator": "^2.0.4"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.6",
    "@types/chrome": "^0.3.6",
    "@types/node": "^22.20.5",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^9.1.2",
    "eslint-plugin-import": "^2.32.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^2.1.9",
    "wxt": "^0.21.4"
  },
  "packageManager": "pnpm@12.15.0"
}
