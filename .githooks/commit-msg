#!/bin/sh
#
# commit-msg —— 检查提交信息是否含敏感值。
#
# ## 为什么单独一个钩子（2026-10-27 真实事故）
#
# 我把「脱敏了哪些值」的表格贴进了提交信息，于是这个
# **「修复泄露」的提交本身又泄露了一遍**。
#
# 文件内容的检查（pre-commit）拦不住这个 —— 提交信息不在文件里。
#
# ## 检查什么
#
# 1. 已登记的敏感值（哈希比对）
# 2. 通用规则：**9 位以上连续数字一律警告**
#
#    文件里的长数字多是合法的（版本号、测试数据、时间戳常量），
#    但提交信息里几乎没有合理理由出现 —— mid / uid / 毫秒时间戳 /
#    会员到期日全在这个区间。宁可误报，也不放过。
#
#    误报豁免：信息里写 `secrets-ok: 理由`。
#
# $1 = 提交信息文件路径

node scripts/check-secrets.mjs --commit-msg "$1"
status=$?

if [ $status -ne 0 ]; then
  echo ''
  echo '━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━'
  echo '  提交已阻止：提交信息含敏感信息'
  echo '━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━'
  echo ''
  echo '  描述"改了什么"时用类别，不要用具体值：'
  echo '      改前：修正 mid <一串数字> 的续播问题'
  echo '      改后：修正主账号 mid 的续播问题'
  echo ''
  echo '  确实要跳过检查（不建议）：'
  echo '      git commit --no-verify'
  echo ''
  exit 1
fi

exit 0
